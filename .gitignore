# Unity cache, generated projects and local output
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/UserSettings/
/MemoryCaptures/
/.vs/
/.vscode/
/.idea/
/.codex/
/.agents/
*.csproj
*.sln
*.user
*.suo
*.pidb
*.pdb
*.mdb
*.zip
*.log
*.local.ini
.env
*.mp4
*.avi
/Assets/AssetStoreTools/

# External assets are excluded from this source-only repository.
/Assets/*
!/Assets/MYFolder/
!/Assets/MYFolder.meta
/Assets/MYFolder/*
!/Assets/MYFolder/Script/
!/Assets/MYFolder/Script.meta
/Assets/MYFolder/Script/**/*
!/Assets/MYFolder/Script/**/
!/Assets/MYFolder/Script/**/*.cs
!/Assets/MYFolder/Script/**/*.cs.meta
!/Assets/MYFolder/Editor/
!/Assets/MYFolder/Editor.meta
!/Assets/MYFolder/ExportedFieldData/
!/Assets/MYFolder/ExportedFieldData.meta
!/Assets/MYFolder/Scenes/
!/Assets/MYFolder/Scenes.meta
/Assets/MYFolder/Scenes/*
!/Assets/MYFolder/Scenes/LoginScene.unity
!/Assets/MYFolder/Scenes/LoginScene.unity.meta
!/Assets/MYFolder/Scenes/TownScene.unity
!/Assets/MYFolder/Scenes/TownScene.unity.meta
!/Assets/MYFolder/Scenes/BeginnerZoneScene.unity
!/Assets/MYFolder/Scenes/BeginnerZoneScene.unity.meta

# Keep reusable editor tools; exclude local conversion and capture scripts.
/Assets/MYFolder/Editor/*
!/Assets/MYFolder/Editor/ChatScrollbarSetup.cs
!/Assets/MYFolder/Editor/ChatScrollbarSetup.cs.meta
!/Assets/MYFolder/Editor/LoginSceneUIBuilder.cs
